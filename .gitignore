# Ignore Everything
/*

# Allow .gitignore
!.gitignore

# Allow config files/directories I want tracked
!.zshrc

# Allow .config directory
!/.config

# Ignore everything in the .config directory
/.config/*

# Allow specific config directories
!/.config/mise
!/.config/nvim
!/.config/oh-my-posh
!/.config/tmux
!/.config/zellij
!/.config/zsh

# Ignore automatically generated backup files
*~
